# Conexão com o banco de dados PostgreSQL (gerado automaticamente no Railway ou local)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=coloque_uma_chave_secreta_forte_aqui_para_o_jwt

# Chave de API do Groq (https://console.groq.com)
GROQ_API_KEY=sua_chave_groq_aqui

# (Opcional) Google OAuth2 para autenticação com Google (fluxo popup)
# GOOGLE_CLIENT_ID: disponível em console.cloud.google.com → Credenciais → ID do cliente OAuth2
# GOOGLE_CLIENT_SECRET: necessário para trocar o authorization code por tokens (fluxo popup)
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# Porta local (no Railway a variável PORT é injetada automaticamente)
PORT=8000

# Brevo (ex-Sendinblue) - Envio de e-mails transacionais (código de verificação)
BREVO_API_KEY=sua_chave_api_brevo_aqui
BREVO_SENDER_EMAIL=noreply@seudominio.com.br
BREVO_SENDER_NAME=AgroBot

