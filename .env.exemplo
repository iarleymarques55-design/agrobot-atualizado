# ── Banco de dados PostgreSQL (Railway gera automaticamente ao adicionar
#    o plugin PostgreSQL — use "Add Reference" na variável do serviço) ──
DATABASE_URL=postgresql://usuario:senha@host:5432/agrobot

# ── Segredo para assinar os tokens JWT (gere um valor aleatório) ──
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_e_seguro

# ── Chave da API da Groq (https://console.groq.com/keys) ──
GROQ_API_KEY=sua_chave_groq_aqui

# ── Client ID do login com Google ──
# Console do Google Cloud → APIs e Serviços → Credenciais →
# "Criar credenciais" → "ID do cliente OAuth" → tipo "Aplicativo da Web"
# Em "Origens JavaScript autorizadas" adicione:
#   http://localhost:3000  (para testar local)
#   https://SEU-DOMINIO.up.railway.app  (seu domínio do Railway)
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

PORT=3000
